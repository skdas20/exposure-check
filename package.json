    "type": "git",
    "url": "git+https://github.com/skdas20/exposure-check.git"
  },
  "bugs": {
    "url": "https://github.com/skdas20/exposure-check/issues"
  },
  "homepage": "https://github.com/skdas20/exposure-check#readme"
}
